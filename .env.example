# Server-side token from Telegram's BotFather. Keep real values in .env.local or your deployment host.
TELEGRAM_BOT_TOKEN=

# Optional: use the same secret_token when registering the webhook.
# Allowed characters: A-Z, a-z, 0-9, underscores, and hyphens (1-256 characters).
TELEGRAM_WEBHOOK_SECRET=

# Website identity and the independent daily-tracking bot
# Use your HTTPS production origin on Vercel.
APP_URL=http://localhost:3000
DATABASE_URL=
DATABASE_URL_UNPOOLED=
TRACKING_REGISTRATION_ENABLED=false
TRACKING_TELEGRAM_BOT_TOKEN=
TRACKING_TELEGRAM_BOT_USERNAME=
TRACKING_TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_LOGIN_CLIENT_ID=
TELEGRAM_LOGIN_CLIENT_SECRET=
CRON_SECRET=

# Optional dedicated test database. Tests use an isolated temporary schema.
TEST_DATABASE_URL=
